# Copy this file to .env and fill in the values. Never commit .env.

# Required
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional (defaults shown in README.md)
ANTHROPIC_EFFORT=Medium
ENABLE_REFUSAL_FALLBACK=
MAX_RETRIES=
RETRY_BASE_DELAY=
API_TIMEOUT=
MAX_TOKENS=
EXCEL_FILE=
EXCEL_SHEET_NAME=
OUTPUT_DIR=output
LOG_DIR=logs
DATA_DIR=data
MAX_PROJECTS=
REQUEST_DELAY=

# Optional: path to the prompt rules file (default: prompt-rules.md)
PROMPT_RULES_FILE=
